 * Instagram direct messages. The entry is the Instagram account (not the
 * Page), the sender the person's Instagram-scoped id. A message the
 * account sent itself comes back with "is_echo"; one the person deleted
 * comes again with "is_deleted", kept under its own id so it is not taken
 * for a repeat; a tap on an ad by somebody who already has a chat comes
 * as a "referral" alone. Meta's dashboard test sends the same event in the
 * "changes" shape, so both are read.
 *
 * @param  array<string, mixed>  $payload
 */";s:9:"startLine";i:95;s:7:"endLine";i:127;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:4;s:9:"namespace";s:33:"App\Modules\Meta\Http\Controllers";s:18:"declaringClassName";s:55:"App\Modules\Meta\Http\Controllers\MetaWebhookController";s:21:"implementingClassName";s:55:"App\Modules\Meta\Http\Controllers\MetaWebhookController";s:16:"currentClassName";s:55:"App\Modules\Meta\Http\Controllers\MetaWebhookController";s:9:"aliasName";N;}s:5:"store";a:20:{s:4:"name";s:5:"store";s:10:"parameters";a:3:{s:6:"source";a:13:{s:4:"name";s:6:"source";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:134;s:7:"endLine";i:134;s:11:"startColumn";i:28;s:9:"endColumn";i:41;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:10:"externalId";a:13:{s:4:"name";s:10:"externalId";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}}}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:134;s:7:"endLine";i:134;s:11:"startColumn";i:44;s:9:"endColumn";i:62;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:7:"payload";a:13:{s:4:"name";s:7:"payload";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"by