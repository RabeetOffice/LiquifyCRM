O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v2-6.73.0.5-8.4.26-0513d5928af62535de7d90e18b164e28a4ea53a87014fd236997c160112afcb6";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:32:"App\Modules\Core\Support\RunSoon";s:8:"filename";s:63:"C:/xampp/htdocs/LiquifyCRM/app/Modules/Core/Support/RunSoon.php";}}s:9:"namespace";s:24:"App\Modules\Core\Support";s:4:"name";s:32:"App\Modules\Core\Support\RunSoon";s:9:"shortName";s:7:"RunSoon";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:507:"/**
 * Work that should not wait for the scheduler's next minute: turning a lead
 * that just arrived into a lead on screen, sending a Messenger reply. During
 * a web request it runs right after the answer has gone out, in the same
 * process, so nobody waits for it and it needs no worker. From the command
 * line and inside queue workers it goes on the queue as usual.
 *
 * Only for jobs that look after their own failures (one try, the error kept
 * on the record): nothing retries what runs here.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:17;s:7:"endLine";i:29;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:1:{s:8:"dispatch";a:20:{s:4:"name";s:8:"dispatch";s:10:"parameters";a:1:{s:3:"job";a:13:{s:4:"name";s:3:"job";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"object";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:19;s:7:"endLine";i:19;s:11:"startColumn";i:37;s:9:"endColumn";i:47;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"void";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:19;s:7:"endLine";i:28;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:17;s:9:"namespace";s:24:"App\Modules\Core\Support";s:18:"declaringClassName";s:32:"App\Modules\Core\Support\RunSoon";s:21:"implementingClassName";s:32:"App\Modules\Core\Support\RunSoon";s:16:"currentClassName";s:32:"App\Modules\Core\Support\RunSoon";s:9:"aliasName";N;}}s:10:"traitsData";a:4:{s:7:"aliases";a:0:{}s:9:"modifiers";a:0:{}s:11:"precedences";a:0:{}s:6:"hashes";a:0:{}}}}