 * Retrieve the authority component of the URI.
 *
 * If no authority information is present, this method MUST return an empty
 * string.
 *
 * The authority syntax of the URI is:
 *
 * <pre>
 * [user-info@]host[:port]
 * </pre>
 *
 * If the port component is not set or is the standard port for the current
 * scheme, it SHOULD NOT be included.
 *
 * @see https://tools.ietf.org/html/rfc3986#section-3.2
 * @return string The URI authority, in "[user-info@]host[:port]" format.
 */";s:9:"startLine";i:61;s:7:"endLine";i:61;s:11:"startColumn";i:5;s:9:"endColumn";i:43;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:16:"Psr\Http\Message";s:18:"declaringClassName";s:29:"Psr\Http\Message\UriInterface";s:21:"implementingClassName";s:29:"Psr\Http\Message\UriInterface";s:16:"currentClassName";s:29:"Psr\Http\Message\UriInterface";s:9:"aliasName";N;}s:11:"getUserInfo";a:20:{s:4:"name";s:11:"getUserInfo";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:524:"/**
 * Retrieve the user information component of the URI.
 *
 * If no user information is present, this method MUST return an empty
