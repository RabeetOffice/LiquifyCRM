<?php
/* =============================================================================
   liquify.php: sends this website's form leads to LiquifyCRM
   Generated by LiquifyCRM for {{DOMAIN}}. Nothing to edit.

   - The visitor never waits: the lead is saved to a small local queue first,
     then sent after the thank-you page has already loaded.
   - A CRM outage never loses a lead: unsent leads stay in includes/liquify-queue/
     and go with the next submission (or the optional cron).
   - All processing (validation, de-duplication, emails, storage) happens in
     LiquifyCRM. This file only delivers.
============================================================================= */

const LIQUIFY_URL    = '{{URL}}';
const LIQUIFY_SECRET = '{{SECRET}}';
const LIQUIFY_QUEUE  = __DIR__ . '/liquify-queue';
const LIQUIFY_GUARD  = "<?php exit; ?>\n"; // queued files are .php, so a browser can never read them

/** Queue one lead and send it once the page has finished. */
function liquify_send(string $form, $externalId, array $fields): void
{
    try {
        $meta = [
            'page_url'   => $fields['page_url'] ?? ($_SERVER['HTTP_REFERER'] ?? ''),
            'ip'         => $fields['ip_address'] ?? ($_SERVER['REMOTE_ADDR'] ?? ''),
            'user_agent' => $fields['user_agent'] ?? ($_SERVER['HTTP_USER_AGENT'] ?? ''),
        ];
        foreach (['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'] as $k) {
            if (!empty($_REQUEST[$k])) {
                $meta[$k] = (string) $_REQUEST[$k];
            }
        }
        unset($fields['page_url'], $fields['ip_address'], $fields['user_agent'], $fields['form_type']);

        $payload = [
            'form'         => $form !== '' ? $form : 'website',
            'external_id'  => $externalId === null ? '' : (string) $externalId,
            'submitted_at' => gmdate('c'),
            'fields'       => array_filter($fields, fn ($v) => $v !== '' && $v !== null),
            'meta'         => $meta,
        ];

        if (!is_dir(LIQUIFY_QUEUE)) {
            @mkdir(LIQUIFY_QUEUE, 0750, true);
        }
        $file = sprintf('%s/%s-%06d-%s.php', LIQUIFY_QUEUE, gmdate('Ymd-His'), (int) (fmod(microtime(true), 1) * 1e6), bin2hex(random_bytes(3)));
        file_put_contents($file, LIQUIFY_GUARD . json_encode($payload, JSON_UNESCAPED_UNICODE), LOCK_EX);

        register_shutdown_function(function () {
            if (function_exists('fastcgi_finish_request')) {
                fastcgi_finish_request(); // the visitor already has the thank-you page
            }
            liquify_flush();
        });
    } catch (Throwable $e) {
        error_log('[liquify] ' . $e->getMessage()); // never break the form
    }
}

/** Send queued leads, oldest first. Stops at the first connection failure. */
function liquify_flush(int $max = 10): void
{
    $files = glob(LIQUIFY_QUEUE . '/*.php') ?: [];
    foreach (array_slice($files, 0, $max) as $file) {
        $raw = @file_get_contents($file);
        if ($raw === false) {
            continue; // already sent by a parallel request
        }
        $code = liquify_post(substr($raw, strlen(LIQUIFY_GUARD)));
        $accepted = $code >= 200 && $code < 300;
        $rejected = $code >= 400 && $code < 500 && !in_array($code, [401, 403, 408, 429], true);
        if ($accepted || $rejected) {
            if ($rejected) {
                error_log('[liquify] CRM rejected ' . basename($file) . ' with HTTP ' . $code);
            }
            @unlink($file);
            continue;
        }
        break; // CRM offline or misconfigured: keep the rest for later
    }
}

/** One signed POST. Returns the HTTP status, or 0 when there was no connection. */
function liquify_post(string $body): int
{
    $timestamp = (string) time();
    $ch = curl_init(LIQUIFY_URL);
    curl_setopt_array($ch, [
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => $body,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_CONNECTTIMEOUT => 3,
        CURLOPT_TIMEOUT        => 5,
        CURLOPT_HTTPHEADER     => [
            'Content-Type: application/json',
            'X-Liquify-Timestamp: ' . $timestamp,
            'X-Liquify-Signature: sha256=' . hash_hmac('sha256', $timestamp . '.' . $body, LIQUIFY_SECRET),
        ],
    ]);
    curl_exec($ch);
    $code = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    return $code;
}
