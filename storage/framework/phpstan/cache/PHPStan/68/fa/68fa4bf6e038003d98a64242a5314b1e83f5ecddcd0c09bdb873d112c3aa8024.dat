 *     ...
 * } $config Client configuration settings and default request options.
 *
 * @see RequestOptions for a list of available request options.
 */";s:9:"startLine";i:163;s:7:"endLine";i:237;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:10:"GuzzleHttp";s:18:"declaringClassName";s:17:"GuzzleHttp\Client";s:21:"implementingClassName";s:17:"GuzzleHttp\Client";s:16:"currentClassName";s:17:"GuzzleHttp\Client";s:9:"aliasName";N;}s:9:"sendAsync";a:20:{s:4:"name";s:9:"sendAsync";s:10:"parameters";a:2:{s:7:"request";a:13:{s:4:"name";s:7:"request";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:33:"Psr\Http\Message\RequestInterface";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:1:{i:0;a:3:{s:4:"name";s:18:"SensitiveParameter";s:10:"isRepeated";b:0;s:9:"arguments";a:0:{}}}s:9:"startLine";i:320;s:7:"endLine";i:321;s:11:"startColumn";i:9;s:9:"endColumn";i:33;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:7:"options";a:13:{s:4:"name";s:7:"options";s:7:"default";a:2:{s:4:"code";s:2:"[]";s:10:"attributes";a:6:{s:9:"startLine";i:323;s:7:"endLine";i:323;s:13:"startTokenPos";i:799;s:12:"startFilePos";i:13947;s:11:"endTokenPos";i:800;s:10:"endFilePos";i:13948;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:1:{i:0;a:3:{s:4:"name";s:18:"SensitiveParameter";s:10:"isRepeated";b:0;s:9:"arguments";a:0:{}}}s:9:"startLine";i:322;s:7:"endLine";i:323;s:11:"startColumn";i:9;s:9:"endColumn";i:27;s:14:"parameterIndex";i:1;s:10:"isOptional";b:1;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:35:"GuzzleHttp\Promise\PromiseInterface";s:12:"isIdentifier";b:0;}}s:10:"attributes";a:0: