<?php
/* =============================================================================
   liquify.php: connects {{DOMAIN}} to LiquifyCRM.
   Made by LiquifyCRM for this website. Nothing to edit.

   Upload it to the website's root folder (next to index.php). That is all:
   LiquifyCRM asks this file every minute for the new rows of the website's
   own leads table, so the forms keep working exactly as before.

   - It finds the database details in the website's config file
     (includes/config.php) without running it, and it only reads.
   - It answers LiquifyCRM only: every question carries a signature made with
     this website's secret, and a question older than 5 minutes is refused.
   - Optional, for leads in seconds instead of within a minute: two lines in
     the form handler, right after the lead is saved (LiquifyCRM shows them).
============================================================================= */

const LIQUIFY_URL     = '{{URL}}';
const LIQUIFY_SECRET  = '{{SECRET}}';
const LIQUIFY_VERSION = '2.0';

// Only if this website keeps its settings or its leads somewhere else:
// define('LIQUIFY_CONFIG', 'includes/config.php');
// define('LIQUIFY_TABLE', 'leads');

/* ------------------------------------------------------------------------------
   Optional instant send, from the form handler:
     require_once __DIR__ . '/liquify.php';
     liquify_send($lead['form_type'], $db['id'], $lead);
------------------------------------------------------------------------------ */

if (!function_exists('liquify_send')) {
    /** Send one lead after the visitor has the thank-you page. If it does not get through, LiquifyCRM reads it within a minute anyway. */
    function liquify_send($form, $externalId, array $fields)
    {
        try {
            $meta = array(
                'page_url'   => isset($fields['page_url']) ? (string) $fields['page_url'] : (isset($_SERVER['HTTP_REFERER']) ? (string) $_SERVER['HTTP_REFERER'] : ''),
                'ip'         => isset($fields['ip_address']) ? (string) $fields['ip_address'] : (isset($_SERVER['REMOTE_ADDR']) ? (string) $_SERVER['REMOTE_ADDR'] : ''),
                'user_agent' => isset($fields['user_agent']) ? (string) $fields['user_agent'] : (isset($_SERVER['HTTP_USER_AGENT']) ? (string) $_SERVER['HTTP_USER_AGENT'] : ''),
            );
            foreach (array('utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid') as $key) {
                if (!empty($_REQUEST[$key]) && is_string($_REQUEST[$key])) {
                    $meta[$key] = $_REQUEST[$key];
                }
            }
            unset($fields['page_url'], $fields['ip_address'], $fields['user_agent'], $fields['form_type']);

            $clean = array();
            foreach ($fields as $key => $value) {
                $value = liquify_value($value);
                if ($value !== '' && $value !== null) {
                    $clean[$key] = $value;
                }
            }

            $body = json_encode(array(
                'form'         => (string) $form !== '' ? (string) $form : 'website',
                'external_id'  => $externalId === null ? '' : (string) $externalId,
                'submitted_at' => gmdate('c'),
                'fields'       => $clean,
                'meta'         => $meta,
            ), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);

            register_shutdown_function(function () use ($body) {
                if (function_exists('fastcgi_finish_request')) {
                    fastcgi_finish_request(); // the visitor already has the thank-you page
                }
                liquify_post((string) $body);
            });
        } catch (Throwable $e) {
            error_log('[liquify] ' . $e->getMessage()); // never break the form
        }
    }

    /** One signed POST to LiquifyCRM. Returns the HTTP status, or 0 when there was no connection. */
    function liquify_post($body)
    {
        $timestamp = (string) time();
        $ch = curl_init(LIQUIFY_URL);
        curl_setopt_array($ch, array(
            CURLOPT_POST           => true,
            CURLOPT_POSTFIELDS     => $body,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_CONNECTTIMEOUT => 3,
            CURLOPT_TIMEOUT        => 5,
            CURLOPT_HTTPHEADER     => array(
                'Content-Type: application/json',
                'X-Liquify-Timestamp: ' . $timestamp,
                'X-Liquify-Signature: sha256=' . hash_hmac('sha256', $timestamp . '.' . $body, LIQUIFY_SECRET),
            ),
        ));
        curl_exec($ch);
        $code = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);

        return $code;
    }
}

/* ------------------------------------------------------------------------------
   Answers to LiquifyCRM (when this file is opened directly)
------------------------------------------------------------------------------ */

/** A stored value as plain text: a list such as an attachments column becomes its names. */
function liquify_value($value)
{
    if (is_string($value) && $value !== '' && ($value[0] === '[' || $value[0] === '{')) {
        $decoded = json_decode($value, true);
        if (is_array($decoded) && $decoded !== array() && array_keys($decoded) === range(0, count($decoded) - 1)) {
            $value = $decoded;
        }
    }

    if (is_array($value)) {
        $names = array();
        foreach ($value as $item) {
            if (is_array($item) && isset($item['name']) && is_scalar($item['name'])) {
                $names[] = (string) $item['name'];
            } elseif (is_scalar($item)) {
                $names[] = (string) $item;
            }
        }

        return implode(', ', $names);
    }

    return $value;
}

function liquify_reply(array $payload, $status = 200)
{
    while (ob_get_level() > 0) {
        ob_end_clean();
    }
    http_response_code($status);
    header('Content-Type: application/json; charset=utf-8');
    header('Cache-Control: no-store');
    header('X-Robots-Tag: noindex');
    echo json_encode($payload + array('liquify' => LIQUIFY_VERSION), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PARTIAL_OUTPUT_ON_ERROR);
    exit;
}

function liquify_answer()
{
    ini_set('display_errors', '0');
    ob_start();
    set_error_handler(function () { return true; }); // a PHP notice must never spoil the answer

    if ((isset($_SERVER['REQUEST_METHOD']) ? $_SERVER['REQUEST_METHOD'] : '') !== 'POST') {
        liquify_reply(array('ok' => false, 'error' => 'This file connects the website to LiquifyCRM and only answers LiquifyCRM.'), 405);
    }

    $body = (string) file_get_contents('php://input');
    $timestamp = isset($_SERVER['HTTP_X_LIQUIFY_TIMESTAMP']) ? (string) $_SERVER['HTTP_X_LIQUIFY_TIMESTAMP'] : '';
    $signature = isset($_SERVER['HTTP_X_LIQUIFY_SIGNATURE']) ? trim((string) $_SERVER['HTTP_X_LIQUIFY_SIGNATURE']) : '';

    if (!ctype_digit($timestamp) || abs(time() - (int) $timestamp) > 300) {
        liquify_reply(array('ok' => false, 'error' => 'The question is too old or has no time. Check the clock of the website\'s server.'), 401);
    }
    if (!hash_equals('sha256=' . hash_hmac('sha256', $timestamp . '.' . $body, LIQUIFY_SECRET), $signature)) {
        liquify_reply(array('ok' => false, 'error' => 'The signature does not match this website\'s secret. Download liquify.php again from LiquifyCRM.'), 401);
    }

    $request = json_decode($body, true);
    $action = is_array($request) && isset($request['action']) ? (string) $request['action'] : '';
    $params = is_array($request) && isset($request['params']) && is_array($request['params']) ? $request['params'] : array();

    if ($action === 'ping') {
        liquify_reply(array('ok' => true, 'data' => liquify_ping()));
    }
    if ($action === 'leads') {
        liquify_reply(liquify_leads($params));
    }
    if ($action === 'diagnostics') {
        liquify_reply(array('ok' => true, 'data' => array('checks' => liquify_diagnostics())));
    }

    liquify_reply(array('ok' => false, 'error' => 'Unknown question: ' . $action), 400);
}

/** The website's settings: define('NAME', 'value') lines of its config file, read without running it. */
function liquify_settings()
{
    static $settings = null;
    if ($settings !== null) {
        return $settings;
    }

    $files = defined('LIQUIFY_CONFIG')
        ? array(LIQUIFY_CONFIG)
        : array('includes/config.php', 'config.php', 'includes/db.php', 'includes/database.php', 'inc/config.php', 'config/config.php', 'admin/config.php');

    $settings = array('file' => null, 'values' => array());

    foreach ($files as $file) {
        $path = __DIR__ . '/' . ltrim($file, '/');
        if (!is_file($path) || !is_readable($path)) {
            continue;
        }
        $values = liquify_defines((string) file_get_contents($path));
        if (isset($values['DB_NAME']) || isset($values['DB_DATABASE'])) {
            $settings = array('file' => $file, 'values' => $values);
            break;
        }
    }

    return $settings;
}

function liquify_defines($code)
{
    $tokens = array();
    foreach (token_get_all($code) as $token) {
        if (!is_array($token) || !in_array($token[0], array(T_WHITESPACE, T_COMMENT, T_DOC_COMMENT), true)) {
            $tokens[] = $token;
        }
    }

    $values = array();
    for ($i = 0, $n = count($tokens); $i + 5 < $n; $i++) {
        $define = $tokens[$i];
        if (!is_array($define) || $define[0] !== T_STRING || strtolower($define[1]) !== 'define' || $tokens[$i + 1] !== '(') {
            continue;
        }
        $name = $tokens[$i + 2];
        $value = $tokens[$i + 4];
        if (!is_array($name) || $name[0] !== T_CONSTANT_ENCAPSED_STRING || $tokens[$i + 3] !== ',' || !is_array($value) || $tokens[$i + 5] !== ')') {
            continue;
        }
        if ($value[0] === T_CONSTANT_ENCAPSED_STRING) {
            $values[liquify_literal($name[1])] = liquify_literal($value[1]);
        } elseif ($value[0] === T_LNUMBER) {
            $values[liquify_literal($name[1])] = $value[1];
        }
    }

    return $values;
}

function liquify_literal($literal)
{
    $inner = substr($literal, 1, -1);

    return $literal[0] === "'" ? str_replace(array("\\'", '\\\\'), array("'", '\\'), $inner) : stripcslashes($inner);
}

function liquify_setting(array $names, $default = null)
{
    $values = liquify_settings();
    foreach ($names as $name) {
        if (isset($values['values'][$name]) && $values['values'][$name] !== '') {
            return $values['values'][$name];
        }
    }

    return $default;
}

/** A connection to the website's database, or the reason there is none. */
function liquify_pdo(&$error)
{
    $error = null;
    $name = liquify_setting(array('DB_NAME', 'DB_DATABASE'));
    if ($name === null) {
        $error = 'No database settings were found (looked for DB_NAME in includes/config.php).';
        return null;
    }

    $host = liquify_setting(array('DB_HOST', 'DB_SERVER'), 'localhost');
    $port = liquify_setting(array('DB_PORT'));
    $dsn = 'mysql:host=' . $host . ($port ? ';port=' . (int) $port : '') . ';dbname=' . $name . ';charset=' . liquify_setting(array('DB_CHARSET'), 'utf8mb4');

    try {
        return new PDO($dsn, (string) liquify_setting(array('DB_USER', 'DB_USERNAME'), ''), (string) liquify_setting(array('DB_PASS', 'DB_PASSWORD'), ''), array(
            PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_TIMEOUT            => 5,
        ));
    } catch (Throwable $e) {
        $error = 'The database did not accept the connection: ' . $e->getMessage();
        return null;
    }
}

/** The table the form saves leads in. */
function liquify_table(PDO $pdo)
{
    $names = defined('LIQUIFY_TABLE') ? array(LIQUIFY_TABLE) : array('leads', 'enquiries', 'submissions', 'contact_submissions', 'form_submissions', 'inquiries');
    foreach ($names as $name) {
        if (!preg_match('/^[A-Za-z0-9_]+$/', $name)) {
            continue;
        }
        if ($pdo->query('SHOW TABLES LIKE ' . $pdo->quote($name))->fetchColumn()) {
            return $name;
        }
    }

    return null;
}

function liquify_ping()
{
    $data = array('php' => PHP_VERSION, 'config' => liquify_settings()['file'], 'table' => null, 'rows' => null, 'max_id' => null, 'error' => null);
    $pdo = liquify_pdo($error);
    if ($pdo === null) {
        $data['error'] = $error;
        return $data;
    }

    try {
        $table = liquify_table($pdo);
        if ($table === null) {
            $data['error'] = 'The database has no leads table yet (looked for leads, enquiries and submissions).';
            return $data;
        }
        $row = $pdo->query('SELECT COUNT(*) AS n, MAX(id) AS max_id FROM `' . $table . '`')->fetch();
        $data['table'] = $table;
        $data['rows'] = (int) $row['n'];
        $data['max_id'] = (int) $row['max_id'];
    } catch (Throwable $e) {
        $data['error'] = 'The leads table could not be read: ' . $e->getMessage();
    }

    return $data;
}

/** Rows after since_id, oldest first. */
function liquify_leads(array $params)
{
    $since = isset($params['since_id']) ? max(0, (int) $params['since_id']) : 0;
    $limit = isset($params['limit']) ? min(1000, max(1, (int) $params['limit'])) : 500;

    $pdo = liquify_pdo($error);
    if ($pdo === null) {
        return array('ok' => false, 'error' => $error);
    }

    try {
        $table = liquify_table($pdo);
        if ($table === null) {
            return array('ok' => false, 'error' => 'The database has no leads table yet (looked for leads, enquiries and submissions).');
        }
        $statement = $pdo->prepare('SELECT * FROM `' . $table . '` WHERE id > ? ORDER BY id ASC LIMIT ' . ($limit + 1));
        $statement->execute(array($since));
        $rows = $statement->fetchAll();
    } catch (Throwable $e) {
        return array('ok' => false, 'error' => 'The leads table could not be read: ' . $e->getMessage());
    }

    $more = count($rows) > $limit;
    $leads = array();
    foreach (array_slice($rows, 0, $limit) as $row) {
        foreach ($row as $key => $value) {
            $row[$key] = liquify_value($value);
        }
        $leads[] = $row;
    }

    return array('ok' => true, 'data' => array('leads' => $leads, 'has_more' => $more, 'table' => $table));
}

/** The email and database checks of the website's health page. */
function liquify_diagnostics()
{
    $checks = array();
    $started = microtime(true);
    $pdo = liquify_pdo($error);
    if ($pdo === null) {
        $checks[] = liquify_check('database', 'Database', 'fail', $error, 'Check DB_HOST, DB_NAME, DB_USER and DB_PASS in ' . (liquify_settings()['file'] ?: 'includes/config.php') . '.', $started);
    } else {
        $ping = liquify_ping();
        $checks[] = $ping['table'] !== null
            ? liquify_check('database', 'Database', 'ok', 'Connected. ' . $ping['rows'] . ' rows in the ' . $ping['table'] . ' table.', null, $started)
            : liquify_check('database', 'Database', 'warn', (string) $ping['error'], 'The form saves its first lead into this table.', $started);
    }

    $checks[] = liquify_smtp();

    return $checks;
}

function liquify_check($group, $label, $status, $message, $fix, $started)
{
    return array('group' => $group, 'label' => $label, 'status' => $status, 'message' => $message, 'fix' => $fix, 'ms' => (int) round((microtime(true) - $started) * 1000));
}

/** Signs in to the website's mail server the way its form does, then leaves. Nothing is sent. */
function liquify_smtp()
{
    $started = microtime(true);
    $host = liquify_setting(array('SMTP_HOST', 'MAIL_HOST'));
    if ($host === null) {
        return liquify_check('email', 'Email', 'skip', 'No SMTP settings in the config file: the website sends email another way.', null, $started);
    }

    $port = (int) liquify_setting(array('SMTP_PORT', 'MAIL_PORT'), 587);
    $secure = strtolower((string) liquify_setting(array('SMTP_ENCRYPTION', 'SMTP_SECURE', 'MAIL_ENCRYPTION'), $port === 465 ? 'ssl' : 'tls'));
    $user = (string) liquify_setting(array('SMTP_USER', 'SMTP_USERNAME', 'MAIL_USERNAME'), '');
    $pass = (string) liquify_setting(array('SMTP_PASS', 'SMTP_PASSWORD', 'MAIL_PASSWORD'), '');
    $where = $host . ':' . $port;

    $socket = @stream_socket_client(($secure === 'ssl' ? 'ssl://' : 'tcp://') . $where, $errno, $errstr, 8);
    if (!$socket) {
        return liquify_check('email', 'Email', 'fail', 'The mail server ' . $where . ' could not be reached: ' . $errstr, 'Check SMTP_HOST and SMTP_PORT.', $started);
    }
    stream_set_timeout($socket, 8);

    $read = function () use ($socket) {
        $answer = '';
        while (($line = fgets($socket, 515)) !== false) {
            $answer .= $line;
            if (strlen($line) < 4 || $line[3] === ' ') {
                break;
            }
        }
        return $answer;
    };
    $say = function ($command) use ($socket, $read) {
        fwrite($socket, $command . "\r\n");
        return $read();
    };
    $code = function ($answer) {
        return (int) substr($answer, 0, 3);
    };
    $fail = function ($message, $fix) use ($socket, $started) {
        @fclose($socket);
        return liquify_check('email', 'Email', 'fail', $message, $fix, $started);
    };

    if ($code($read()) !== 220) {
        return $fail('The mail server ' . $where . ' did not greet.', 'Check SMTP_HOST and SMTP_PORT.');
    }
    $name = gethostname() ?: 'localhost';
    $say('EHLO ' . $name);

    if ($secure === 'tls' || $secure === 'starttls') {
        if ($code($say('STARTTLS')) !== 220) {
            return $fail('The mail server refused a secure connection.', 'Try SMTP_ENCRYPTION ssl with port 465.');
        }
        $methods = STREAM_CRYPTO_METHOD_TLS_CLIENT;
        if (defined('STREAM_CRYPTO_METHOD_TLSv1_2_CLIENT')) {
            $methods |= STREAM_CRYPTO_METHOD_TLSv1_2_CLIENT;
        }
        if (defined('STREAM_CRYPTO_METHOD_TLSv1_3_CLIENT')) {
            $methods |= STREAM_CRYPTO_METHOD_TLSv1_3_CLIENT;
        }
        if (!@stream_socket_enable_crypto($socket, true, $methods)) {
            return $fail('The secure connection to the mail server failed.', 'Try SMTP_ENCRYPTION ssl with port 465.');
        }
        $say('EHLO ' . $name);
    }

    if ($user !== '') {
        if ($code($say('AUTH LOGIN')) !== 334 || $code($say(base64_encode($user))) !== 334 || $code($say(base64_encode($pass))) !== 235) {
            return $fail('The mail server refused the login of ' . $user . '.', 'Check SMTP_USER and SMTP_PASS.');
        }
    }

    $say('QUIT');
    @fclose($socket);

    return liquify_check('email', 'Email', 'ok', 'Signed in to the mail server ' . $where . '.', null, $started);
}

if (isset($_SERVER['SCRIPT_FILENAME']) && realpath((string) $_SERVER['SCRIPT_FILENAME']) === __FILE__) {
    liquify_answer();
}
