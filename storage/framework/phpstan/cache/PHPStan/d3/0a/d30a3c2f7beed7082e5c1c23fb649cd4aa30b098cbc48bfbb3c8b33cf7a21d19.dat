 * Return an instance with the specified user information.
 *
 * This method MUST retain the state of the current instance, and return
 * an instance that contains the specified user information.
 *
 * Password is optional, but the user information MUST include the
 * user; an empty string for the user is equivalent to removing user
 * information.
 *
 * @param string $user The user name to use for authority.
 * @param null|string $password The password associated with $user.
 * @return static A new instance with the specified user information.
 */";s:9:"startLine";i:208;s:7:"endLine";i:208;s:11:"startColumn";i:5;s:9:"endColumn";i:87;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:16:"Psr\Http\Message";s:18:"declaringClassName";s:29:"Psr\Http\Message\UriInterface";s:21:"implementingClassName";s:29:"Psr\Http\Message\UriInterface";s:16:"currentClassName";s:29:"Psr\Http\Message\UriInterface";s:9:"aliasName";N;}s:8:"withHost";a:20:{s:4:"name";s:8:"withHost";s:10:"parameters";a:1:{s:4:"host";a:13:{s:4:"name";s:4:"host";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:222;s:7:"endLine";i:222;s:11:"startColumn";i:30;s:9:"endColumn";i:41;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:29:"Psr\Http\Message\UriInterface";s:12:"isIdentifier";b:0;}}s:10:"attributes";a:0:{}s:10:"docComment";s:428:"/**
