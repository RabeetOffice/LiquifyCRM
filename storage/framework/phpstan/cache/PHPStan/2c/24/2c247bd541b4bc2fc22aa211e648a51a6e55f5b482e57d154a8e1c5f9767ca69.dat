 * Return an instance with the specified status code and, optionally, reason phrase.
 *
 * If no reason phrase is specified, implementations MAY choose to default
 * to the RFC 7231 or IANA recommended reason phrase for the response's
 * status code.
 *
 * This method MUST be implemented in such a way as to retain the
 * immutability of the message, and MUST return an instance that has the
 * updated status and reason phrase.
 *
 * @link http://tools.ietf.org/html/rfc7231#section-6
 * @link http://www.iana.org/assignments/http-status-codes/http-status-codes.xhtml
 * @param int $code The 3-digit integer result code to set.
 * @param string $reasonPhrase The reason phrase to use with the
 *     provided status code; if none is provided, implementations MAY
 *     use the defaults as suggested in the HTTP specification.
 * @return static
 * @throws \InvalidArgumentException For invalid status code arguments.
 */";s:9:"startLine";i:52;s:7:"endLine";i:52;s:11:"startColumn";i:5;s:9:"endColumn";i:88;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:16:"Psr\Http\Message";s:18:"declaringClassName";s:34:"Psr\Http\Message\ResponseInterface";s:21:"implementingClassName";s:34:"Psr\Http\Message\ResponseInterface";s:16:"currentClassName";s:34:"Psr\Http\Message\ResponseInterface";s:9:"aliasName";N;}s:15:"getReasonPhrase";a:20:{s:4:"name";s:15:"getReasonPhrase";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:597:"/**
